# Values the PUBLIC build at hoodgram.tech is compiled with.
#
# Next does not read this file. `.env.local` holds the anvil/localhost values for
# development, and Next loads `.env.local` in EVERY environment except test —
# ahead of `.env.production` — so a plain `next build` bakes "Anvil · 31337" and
# "http://localhost:8787" into the public site. That is what shipped on the first
# deploy and was live until 8 Aug 2026.
#
# `scripts/build-site.mjs` reads this file and puts the values into the real
# process environment, which outranks every .env file, so the dev config cannot
# leak into a deploy again. Build the public site with:
#
#     node scripts/build-site.mjs
#
# Chain 46630 is Robinhood Chain Testnet — the network the nine contracts are
# actually deployed on and proven against (docs/PROOF-OF-FUNCTION-TESTNET.md).
# When mainnet (4663) is deployed, change the id, the RPC and all nine addresses
# together; a half-swapped set points the UI at contracts that do not exist.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_START_BLOCK=98182458

# No relay is publicly hosted yet. Left empty on purpose rather than pointed at a
# hostname that does not answer: the messenger degrades into its designed empty
# state, and the footer prints "not public yet" instead of a loopback address.
NEXT_PUBLIC_RELAY_URL=
NEXT_PUBLIC_RELAY_WS=

# Deployed 2026-08-08 on chain 46630 from block 98182458.
# Copied from packages/crypto/src/deployments.ts — keep the two in step.
NEXT_PUBLIC_ADDR_TOKEN=0x597AC1E5826F0FE6A1845a934Dc3f5bB25c4573F
NEXT_PUBLIC_ADDR_PRICE_SOURCE=0xC9e4Bb2A49faE742d9082E26a2AF6a1d24249B5f
NEXT_PUBLIC_ADDR_REVENUE_VAULT=0x080B60Cd7c46C3D3B2D49C1E4dF5455402cdDB7c
NEXT_PUBLIC_ADDR_ACTIVATION=0xd1a671E60CC00e9c6E037CbB979cBFEFdd93E990
NEXT_PUBLIC_ADDR_GROUP_REGISTRY=0x20F2C6f1376a6c6462c43902518a9821a26f1Ee1
NEXT_PUBLIC_ADDR_KEY_REGISTRY=0x8a7d1a0748Fb89b49375Ec8bd734ec2B5AaF600F
NEXT_PUBLIC_ADDR_ANCHORS=0x030d3dCa4283c7feA2E053C05Dcca7BAF482d51D
NEXT_PUBLIC_ADDR_PERKS=0x53d88E8Dc39d5381823a50a59Ac9056C75Fe6074
NEXT_PUBLIC_ADDR_HANDLES=0xA5d2c689f89A525869Ad3b4F9f12207cB2Edc867

# Pre-launch: /access shows the real interface with every figure at zero and
# payments veiled. Launch day is deleting this line and rebuilding.
NEXT_PUBLIC_PRELAUNCH=1
