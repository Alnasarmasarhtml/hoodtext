# Values the PUBLIC build at hoodgram.tech is compiled with.
#
# Next does not read this file. `.env.local` holds the anvil/localhost values for
# development, and Next loads `.env.local` in EVERY environment except test —
# ahead of `.env.production` — so a plain `next build` bakes "Anvil · 31337" and
# "http://localhost:8787" into the public site. That is what shipped on the first
# deploy and was live until 8 Aug 2026.
#
# `scripts/build-site.mjs` reads this file and puts the values into the real
# process environment, which outranks every .env file, so the dev config cannot
# leak into a deploy again. Build the public site with:
#
#     node scripts/build-site.mjs
#
# Chain 4663 is Robinhood Chain MAINNET. The nine contracts below were deployed
# 2026-08-18 from block 39819111, wired to the external test token; on launch
# day ONLY the token line changes (after setToken on chain). A half-swapped set
# points the UI at contracts that do not exist — change addresses only from
# contracts/deployments/4663.json.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_START_BLOCK=39819111

# The public relay on Render (Frankfurt). Both URLs must stay in step — the CSP
# in src/app/layout.tsx derives its connect-src from these two lines plus the
# RPC, so an origin change here is automatically allowed there.
NEXT_PUBLIC_RELAY_URL=https://hoodgram-relay.onrender.com
NEXT_PUBLIC_RELAY_WS=wss://hoodgram-relay.onrender.com/v1/stream

# Deployed 2026-08-18 on chain 4663 from block 39819111.
# Copied from packages/crypto/src/deployments.ts — keep the two in step.
NEXT_PUBLIC_ADDR_TOKEN=0x24DAC33de87dBFf11a7B1CBF02dB4b0668C5e3D6
NEXT_PUBLIC_ADDR_PRICE_SOURCE=0xAA164D5E19F2EeEca56aF3CBBe677533e962f109
NEXT_PUBLIC_ADDR_REVENUE_VAULT=0x168946858dB2890022d598C328a4235b2aaE32d5
NEXT_PUBLIC_ADDR_ACTIVATION=0x063c91F8311b7183B3EEC8099Ee7961c11Dbdc14
NEXT_PUBLIC_ADDR_GROUP_REGISTRY=0x20695Cb87aff1263C4FF60D6e783bd19B465498a
NEXT_PUBLIC_ADDR_KEY_REGISTRY=0x70cF5a2Fcc2869d39B803dBc23907b19f7F6d3Fc
NEXT_PUBLIC_ADDR_ANCHORS=0x69eD2E0f5257A90cb88920B0E4Fa4C7792428237
NEXT_PUBLIC_ADDR_PERKS=0xadAf0D8E2c07dBE120961dadA9f5D1B5f53C6bB9
NEXT_PUBLIC_ADDR_HANDLES=0xc1A4a50aaF556d08b7D4EB36265Ab1Bd6f44E934

# Pre-launch veil, restored 2026-08-19 for the launch reset: /access shows the
# real interface with every figure at zero and payments hidden. Launch day is
# deleting this line (and swapping the token address above) and rebuilding.
NEXT_PUBLIC_PRELAUNCH=1
