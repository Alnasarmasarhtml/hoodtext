# ─── chain ────────────────────────────────────────────────────────────────────
# Robinhood Chain mainnet (verified live 2026-07-29)
RPC_URL=https://rpc.mainnet.chain.robinhood.com/
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com/

# local dev (anvil)
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337

# ─── deploy (NEVER commit a real key) ─────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
# Approved for Anchors.postBatch at deploy time — the gasless-send relay's address.
RELAYER_ADDRESS=

# ─── relay ────────────────────────────────────────────────────────────────────
RELAY_PORT=8787
RELAY_DB_PATH=./data/hoodgram.db
RELAY_BLOB_TTL_DAYS=0
WEB_ORIGIN=http://localhost:3000
START_BLOCK=0
# Contract addresses the relay verifies against (from deployments/<chainid>.json).
ANCHORS_ADDRESS=
ACTIVATION_ADDRESS=
GROUP_REGISTRY_ADDRESS=
KEY_REGISTRY_ADDRESS=
# Funded key the relay posts batches with (NEVER commit a real key).
# Leave empty to disable gasless send; users can always self-post.
RELAYER_PRIVATE_KEY=
RELAY_SEND_FLUSH_MS=1500
RELAY_SEND_QUEUE_MAX=512

# ─── relay: reverse proxy ─────────────────────────────────────────────────────
# !! READ THIS BEFORE DEPLOYING BEHIND Fly / Render / Cloudflare / nginx / any LB.
#
# Number of reverse-proxy hops in front of the relay. It is a COUNT, not a
# boolean, because trusting X-Forwarded-For blindly would let any caller mint a
# fresh rate-limit bucket per request with one spoofed header.
#
#   0 (default) = trust nothing; the client IP is the socket that connected.
#                 Correct ONLY when the relay is directly exposed to the internet.
#   1           = exactly one trusted proxy in front (the common PaaS case).
#   N           = N chained trusted proxies.
#
# Leaving this at 0 BEHIND A PROXY does not fail loudly. It silently turns every
# per-IP rate limit into a GLOBAL limit, because request.ip is then the proxy's
# one address and the whole user base shares a single bucket:
#   - WS /v1/stream  30/min  -> the 31st user in any minute cannot open a socket.
#   - /v1/health    120/min  -> saturated by ~40 monitors polling every 20s.
#   - /v1/drops     240/min  -> two cold clients syncing at once throttle everyone.
#
# To check a running relay: GET /v1/health and read `proxy`. If it reports
# `forwardedHeaderSeen: true` alongside `trustedProxyHops: 0`, this is wrong --
# the relay also logs a warning the first time it sees an X-Forwarded-For header.
RELAY_TRUST_PROXY=0

# ─── web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RELAY_URL=http://localhost:8787
NEXT_PUBLIC_RELAY_WS=ws://localhost:8787/v1/stream
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WALLETCONNECT_ID=
# Contract addresses (from deployments/<chainid>.json), inlined at build time.
NEXT_PUBLIC_ADDR_TOKEN=
NEXT_PUBLIC_ADDR_PRICE_SOURCE=
NEXT_PUBLIC_ADDR_REVENUE_VAULT=
NEXT_PUBLIC_ADDR_ACTIVATION=
NEXT_PUBLIC_ADDR_GROUP_REGISTRY=
NEXT_PUBLIC_ADDR_KEY_REGISTRY=
NEXT_PUBLIC_ADDR_ANCHORS=
NEXT_PUBLIC_ADDR_PERKS=
NEXT_PUBLIC_ADDR_HANDLES=
